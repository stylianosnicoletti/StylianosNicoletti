---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
//mport formatDate from "@/utils/formatDate";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Layout title="Projects">
  <main class="flex flex-col gap-20">
    <h1 class="text-2xl text-neutral-100">Projects</h1>

    <article class="flex flex-col gap-4">
      {
        projects.map((project) => (
          <a
            class="group flex items-center justify-between border-t border-neutral-700 py-4 transition-all hover:text-neutral-100"
            href={`/projects/${project.data.slug}`}
          >
            <h2 class="text-lg">{project.data.title}</h2>

            <div class="flex flex-row items-center gap-4">
              <!--<p>{formatDate(project.data.publishedAt)}</p>-->
              <svg
                width="18"
                height="18"
                viewBox="0 0 18 18"
                fill="none"
                class="transition-all duration-300 group-hover:translate-x-1"
              >
                <path
                  d="M5.25 12.75L12.75 5.25"
                  stroke="#999999"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
                <path
                  d="M5.25 5.25H12.75V12.75"
                  stroke="#999999"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </div>
          </a>
        ))
      }
    </article>
  </main>
</Layout>
